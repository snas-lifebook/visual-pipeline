{
  "name": "visual-pipeline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && vite build",
    "preview": "vite preview",
    "validate": "npm run gen && vitest run",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
