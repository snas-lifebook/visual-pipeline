  },
  "devDependencies": {
    "polygon-clipping": "^0.15.7",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "maplibre-gl": "^6.3.0"
  }
}
